@@ -43,17 +43,31 @@ public class VideoEffectProcessor implements VideoProcessor {
         frame.retain();
         VideoFrame outputFrame = frame;
         for (VideoFrameProcessor processor : this.videoFrameProcessors) {
-            outputFrame = processor.process(outputFrame, textureHelper);
+            VideoFrame next = processor.process(outputFrame, textureHelper);
 
-            if (outputFrame == null) {
-                mSink.onFrame(frame);
-                frame.release();
-                return;
+            // A processor with nothing to do (or one that failed) returns null
+            // or its input: the chain carries on with the picture it already
+            // has, so one idle step does not throw away the steps before it.
+            if (next == null || next == outputFrame) {
+                continue;
             }
+
+            // Each step allocates a new frame. The one it replaced is ours to
+            // release unless it is the captured frame, which is released below;
+            // without this a chain of two or more leaks a frame per frame.
+            if (outputFrame != frame) {
+                outputFrame.release();
+            }
+            outputFrame = next;
         }
 
         mSink.onFrame(outputFrame);
-        outputFrame.release();
+        // With no processors, or a chain that handed its input straight back,
+        // outputFrame IS frame: releasing it twice drops the count below the
+        // capturer's own hold and WebRTC throws on the capture thread.
+        if (outputFrame != frame) {
+            outputFrame.release();
+        }
         frame.release();
     }
 }
