{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-native",
    "noImplicitAny": false,
    "module": "esnext", // or "es2020", "es2022", etc.
    "target": "esnext"
  },
  "exclude": [
    "components/messages/**",
    "dehub-stream-backend",
    "cosmic-echo-hero",
    // Built against a dehubweb checkout, not this app — see their build.js.
    "scripts/theme-backdrop/**",
    "scripts/badge-sticker/**"
  ]
}
