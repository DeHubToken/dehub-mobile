{
  "cli": {
    "version": ">= 16.19.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "store-testing": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "environment": "preview",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "env": {
        "EXPO_PUBLIC_LOCALE_PACK_ORIGIN": "https://staging.dehub.io"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "release-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-arm64-v8a-release.apk"
      }
    },
    "test-apk": {
      "extends": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "applicationArchivePath": "android/app/build/outputs/apk/release/app-arm64-v8a-release.apk"
      },
      "env": {
        "EXPO_PUBLIC_LOCALE_PACK_ORIGIN": "https://staging.dehub.io"
      },
      "environment": "preview"
    }
  },
  "submit": {
    "store-testing": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      },
      "ios": {
        "companyName": "DeLabs LTD",
        "appleTeamId": "J8BTYL3PDK",
        "ascAppId": "6770382811"
      }
    }
  }
}
