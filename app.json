{
  "expo": {
    "scheme": "dehub",
    "name": "DeHub",
    "slug": "dehubmobile",
    "version": "1.18.2",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/playstore.png",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000",
      "enforceContrast": false
    },
    "splash": {
      "image": "./assets/AppIcons/playstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/734211bf-5261-4dce-9e61-2bfc51c339b9"
    },
    "runtimeVersion": "sdk55-frost-1",
    "ios": {
      "supportsTablet": false,
      "jsEngine": "hermes",
      "bundleIdentifier": "io.dehub.mobile",
      "usesAppleSignIn": true,
      "icon": "./assets/AppIcons/appstore.png",
      "associatedDomains": [
        "applinks:dehub.io",
        "webcredentials:dehub.io"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "metamask",
          "trust",
          "safe",
          "rainbow",
          "uniswap"
        ],
        "NSCameraUsageDescription": "DeHub uses your camera when you choose to take a profile photo, record a video for a post, or start a live stream.",
        "NSMicrophoneUsageDescription": "DeHub uses your microphone when you record a voice message or video, or speak in a live stream or audio stage.",
        "NSPhotoLibraryUsageDescription": "DeHub lets you choose photos and videos from your library to share in posts and messages or use as your profile picture. For example, you can select a photo to attach to a new post.",
        "NSPhotoLibraryAddUsageDescription": "DeHub saves a photo or video to your library only when you choose Save or Download, such as saving a photo from a post.",
        "NSLocationWhenInUseUsageDescription": "Share an approximate location on the DeHub community globe only when you choose Place Me."
      },
      "bitcode": false
    },
    "android": {
      "icon": "./assets/AppIcons/playstore.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/playstore.png",
        "backgroundColor": "#000000"
      },
      "allowBackup": false,
      "package": "io.dehub.mobile",
      "versionCode": 47,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
