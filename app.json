            "./node_modules/@expo-google-fonts/exo/500Medium/Exo_500Medium.ttf",
            "./node_modules/@expo-google-fonts/exo/600SemiBold/Exo_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/exo/700Bold/Exo_700Bold.ttf"
