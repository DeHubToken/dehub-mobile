      "bundler": "metro"
    },
    "description": "DeHub is an open source, user owned and censorship resistant social media protocol giving you all the features incumbents refused to.",
    "jsEngine": "hermes",
    "plugins": [
      "expo-splash-screen",
      "expo-secure-store",
      "./libs/reown.queries.js",
      "./libs/android.pointer-tagging.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/AppIcons/notification_badge.png",
          "color": "#8e8e93",
          "defaultChannel": "default"
        }
      ],
      [
